<view class="page">
  <loading-state show="{{loading}}" />
  <view wx:if="{{!loading}}">
    <view class="section-title row space-between">
      <text class="title">购物清单</text>
      <text class="subtitle">{{shoppingList.items.length}} 项</text>
    </view>
    <view class="card" wx:if="{{shoppingList}}">
      <shopping-item
        wx:for="{{shoppingList.items}}"
        wx:key="id"
        item="{{item}}"
        bindtoggle="onToggleShopping"
      />
    </view>
    <empty-state wx:if="{{!shoppingList || shoppingList.items.length === 0}}" text="购物清单为空" />

    <view class="section-title row space-between">
      <text class="title">库存</text>
      <button class="btn btn-secondary sm" bindtap="onTogglePurchase">{{showPurchase ? '收起' : '采购入库'}}</button>
    </view>
    <view class="card purchase" wx:if="{{showPurchase}}">
      <input class="input" placeholder="食材名称" value="{{pf.name}}" data-field="name" bindinput="onPurchaseInput" />
      <view class="row gap pur-row">
        <input class="input grow" type="digit" placeholder="数量" value="{{pf.qty}}" data-field="qty" bindinput="onPurchaseInput" />
        <input class="input w-3" placeholder="单位" value="{{pf.unit}}" data-field="unit" bindinput="onPurchaseInput" />
        <input class="input w-3" type="digit" placeholder="单价" value="{{pf.price}}" data-field="price" bindinput="onPurchaseInput" />
        <button class="btn sm" bindtap="onSubmitPurchase">入库</button>
      </view>
    </view>

    <view class="remind-bar" wx:if="{{expiring.length}}">
      <text class="remind-title">临期提醒</text>
      <text wx:for="{{expiring}}" wx:key="id" class="remind-item">{{item.name}} ×{{item.totalQty}}{{item.unit}}</text>
    </view>

    <view class="chips">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="chip {{activeCategory === item ? 'on' : ''}}"
        data-id="{{item}}"
        bindtap="onCategory"
      >{{item}}</view>
    </view>
    <empty-state wx:if="{{filteredPantry.length === 0}}" text="暂无库存" />
    <pantry-item
      wx:for="{{filteredPantry}}"
      wx:key="id"
      item="{{item}}"
      show-lots="{{true}}"
    />

    <view class="section-title"><text class="title">库存流水</text></view>
    <view class="card" wx:if="{{transactions.length}}">
      <view wx:for="{{transactions}}" wx:key="id" class="tx">
        <text class="tx-name">{{tx.type}} · {{tx.qty}}{{tx.unit}}</text>
        <text class="muted">{{tx.operator}}</text>
      </view>
    </view>
    <empty-state wx:if="{{transactions.length === 0}}" text="暂无流水" />
  </view>
</view>
