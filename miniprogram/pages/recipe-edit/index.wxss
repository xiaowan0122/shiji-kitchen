.cover-pick {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-cream-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
  color: var(--color-muted);
  border: 2rpx dashed var(--color-primary);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-hint {
  font-size: 26rpx;
}
.field {
  margin-bottom: var(--space-sm);
}
.label {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.gap {
  gap: var(--space-sm);
}
.picker {
  color: var(--color-text);
}
.num {
  width: 100rpx;
  flex-shrink: 0;
}
.unit {
  width: 110rpx;
  flex-shrink: 0;
}
.area {
  width: 100%;
  min-height: 120rpx;
}
.ing-row,
.step-row {
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-cream-deep);
}
.ing-row:last-child,
.step-row:last-child {
  border-bottom: none;
}
.opts {
  margin-top: 12rpx;
  gap: var(--space-md);
}
.opt {
  font-size: 24rpx;
  color: var(--color-text);
  display: flex;
  align-items: center;
}
.del {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-danger);
  font-size: 28rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}
.step-idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.tool {
  margin-top: 10rpx;
  justify-content: flex-end;
}
.tool-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-cream-deep);
  color: var(--color-primary-deep);
  border-radius: var(--radius-sm);
  margin-left: 8rpx;
}
.actions {
  gap: var(--space-sm);
  margin: var(--space-md) 0 40rpx;
}
.sm {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
}
