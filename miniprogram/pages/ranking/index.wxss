.seg {
  display: flex;
  flex-direction: row;
  background: var(--color-cream-deep);
  border-radius: var(--radius-md);
  padding: 6rpx;
}
.second {
  margin-top: var(--space-sm);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-sm);
  color: var(--color-muted);
  font-size: 26rpx;
}
.seg-item.on {
  background: var(--color-white);
  color: var(--color-primary-deep);
  font-weight: 600;
}
.scope {
  margin: var(--space-sm) 0;
}
.cost {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}
.entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-cream-deep);
}
.entry:last-child {
  border-bottom: none;
}
.rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-cream-deep);
  color: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.rank-1 {
  background: var(--color-accent);
  color: #FFFFFF;
}
.rank-2,
.rank-3 {
  background: var(--color-primary);
  color: #FFFFFF;
}
.entry-name {
  font-size: 28rpx;
}
.entry-val {
  color: var(--color-muted);
  font-size: 24rpx;
}
