.head {
  margin-bottom: var(--space-md);
}
.date {
  margin-top: 12rpx;
}
.pad {
  padding: var(--space-sm) 0;
}
.stats {
  gap: var(--space-sm);
  margin: var(--space-sm) 0 var(--space-md);
}
.stat {
  flex: 1;
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}
.stat-label {
  color: var(--color-muted);
  font-size: 22rpx;
  margin-top: 6rpx;
}
.grid2 {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid2 recipe-card {
  width: 48.5%;
  margin-bottom: var(--space-sm);
}
.remind {
  margin-top: var(--space-sm);
}
.remind-title {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.remind-item {
  display: block;
  color: var(--color-text);
  font-size: 26rpx;
  padding: 6rpx 0;
}
.record {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: var(--space-sm);
  margin-bottom: var(--space-xs);
}
.record-name {
  font-size: 28rpx;
}
