.ws-wrap {
  margin: var(--space-sm) 0;
}
.type-hint {
  font-size: 24rpx;
}
.member {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-cream-deep);
}
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.mname {
  font-size: 28rpx;
}
.role {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.role-owner {
  background: var(--color-accent);
  color: #FFFFFF;
}
.role-admin {
  background: var(--color-primary);
  color: #FFFFFF;
}
.role-member {
  background: var(--color-cream-deep);
  color: var(--color-muted);
}
.hint {
  margin: var(--space-sm) 0;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.modal {
  width: 560rpx;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: var(--space-md);
}
.code {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--color-primary-deep);
  margin-bottom: var(--space-sm);
}
