.qs {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-cream);
  border-radius: var(--radius-sm);
}
.qs-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: transparent;
  color: var(--color-primary-deep);
  font-size: 34rpx;
  padding: 0;
}
.qs-btn::after {
  border: none;
}
.qs-val {
  min-width: 56rpx;
  text-align: center;
  color: var(--color-text);
  font-size: 30rpx;
}
