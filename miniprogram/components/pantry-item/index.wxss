.pi {
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: var(--space-sm);
  margin-bottom: var(--space-xs);
}
.pi-name {
  font-size: 28rpx;
  font-weight: 600;
}
.exp {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  color: #FFFFFF;
  background: var(--color-danger);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
}
.pi-meta {
  color: var(--color-muted);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.pi-qty {
  color: var(--color-primary-deep);
  font-size: 28rpx;
  font-weight: 600;
}
.pi-lots {
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.lot-badge {
  background: var(--color-cream);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  margin: 4rpx 8rpx 0 0;
}
