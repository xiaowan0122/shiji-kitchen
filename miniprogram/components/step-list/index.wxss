.sl-step {
  display: flex;
  flex-direction: row;
  margin-bottom: var(--space-md);
}
.sl-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.sl-desc {
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
}
.sl-timer {
  color: var(--color-accent);
  font-size: 22rpx;
  margin-top: 6rpx;
}
.sl-img {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-sm);
  margin-top: 12rpx;
}
