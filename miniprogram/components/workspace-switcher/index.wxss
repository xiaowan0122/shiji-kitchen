.ws-current {
  background: var(--color-white);
  border-radius: var(--radius-sm);
  padding: 20rpx var(--space-sm);
}
.ws-name {
  font-size: 30rpx;
  font-weight: 600;
}
.ws-arrow {
  color: var(--color-muted);
  font-size: 22rpx;
}
.ws-list {
  background: var(--color-white);
  border-radius: var(--radius-sm);
  margin-top: 8rpx;
  overflow: hidden;
}
.ws-item {
  padding: 20rpx var(--space-sm);
  border-bottom: 1rpx solid var(--color-cream-deep);
  color: var(--color-text);
  font-size: 28rpx;
}
.ws-item.active {
  color: var(--color-primary-deep);
  font-weight: 600;
}
