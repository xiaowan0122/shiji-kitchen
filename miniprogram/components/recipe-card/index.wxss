.rc {
  background: var(--color-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: var(--space-sm);
}
.cover {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}
.cover image {
  width: 100%;
  height: 100%;
}
.cover.placeholder {
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 64rpx;
}
.fav {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 32rpx;
}
.fav.on {
  color: var(--color-accent);
}
.body {
  padding: var(--space-sm);
}
.rc-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.rc-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: var(--color-muted);
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.rc-meta text {
  margin-right: 8rpx;
}
.tags {
  margin-top: 8rpx;
}
