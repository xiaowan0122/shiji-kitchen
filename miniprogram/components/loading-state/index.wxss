.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}
.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid var(--color-cream-deep);
  border-top-color: var(--color-primary-deep);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.text {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
